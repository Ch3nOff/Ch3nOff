-paper-200/80 font-light leading-relaxed max-w-3xl pt-2","children":"Reflections on moving between archipelagos, studying 繁體字 in Tamsui, and carrying Tarakanita CC5+ values across seas."}]]}]}],["$","div",null,{"className":"max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 pt-12","children":["$","div",null,{"className":"grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-start","children":[["$","aside",null,{"className":"lg:col-span-3 lg:sticky lg:top-24 space-y-8 font-mono text-xs border-b lg:border-b-0 lg:border-r border-ink-dark/10 dark:border-paper-100/10 pb-8 lg:pb-0 pr-0 lg:pr-6","children":[["$","div",null,{"className":"space-y-3","children":[["$","span",null,{"className":"text-[10px] text-accent font-bold uppercase tracking-widest","children":"CHAPTER OUTLINE"}],["$","ul",null,{"className":"space-y-2 text-ink-dark/80 dark:text-paper-200/80 text-[11px]","children":[["$","li","two-suitcases",{"className":"hover:text-accent transition-colors","children":["$","a",null,{"href":"#two-suitcases","className":"block leading-snug","children":[["$","span",null,{"className":"text-accent font-mono mr-1.5","children":["0",1,"."]}],"I. Two Suitcases and a Laptop"]}]}],["$","li","the-geometry-of-traditional-characters",{"className":"hover:text-accent transition-colors","children":["$","a",null,{"href":"#the-geometry-of-traditional-characters","className":"block leading-snug","children":[["$","span",null,{"className":"text-accent font-mono mr-1.5","children":["0",2,"."]}],"II. The Geometry of 繁體字"]}]}],["$","li","the-six-principles-cc5",{"className":"hover:text-accent transition-colors","children":["$","a",null,{"href":"#the-six-principles-cc5","className":"block leading-snug","children":[["$","span",null,{"className":"text-accent font-mono mr-1.5","children":["0",3,"."]}],"III. The Six Principles (CC5+)"]}]}],["$","li","what-anchors-a-builder",{"className":"hover:text-accent transition-colors","children":["$","a",null,{"href":"#what-anchors-a-builder","className":"block leading-snug","children":[["$","span",null,{"className":"text-accent font-mono mr-1.5","children":["0",4,"."]}],"IV. What Anchors a Builder"]}]}]]}]]}],["$","div",null,{"className":"space-y-2 pt-4 border-t border-ink-dark/10 dark:border-paper-100/10 text-[10px] text-ink-muted","children":[["$","div",null,{"children":["AUTHOR: ","Matthew Chen"," (","陳軍宇",")"]}],["$","div",null,{"children":["LOCATION: ","Jiuru / Tamsui, Taiwan"]}],["$","div",null,{"children":["MOOD: ",["$","span",null,{"className":"text-accent font-bold uppercase","children":"Contemplative"}]]}],["$","div",null,{"className":"pt-2","children":["$","a",null,{"href":"https://github.com/Ch3nOff","target":"_blank","rel":"noreferrer","className":"underline hover:text-accent","children":"GitHub @Ch3nOff"}]}]]}]]}],["$","main",null,{"className":"lg:col-span-6 space-y-12","children":[["$","p",null,{"className":"drop-cap font-sans text-lg sm:text-xl text-ink-dark dark:text-paper-100 leading-relaxed font-light","children":"There is a specific feeling that happens when you sit in an empty room in a foreign city for the first time. The ambient frequency of the street is different. The air smells of wet asphalt and sea salt rather than equatorial rain and clove. You open your laptop, pull the latest commit from your repository, and realize that code is the only geography that didn't shift."}],[["$","section","0",{"id":"two-suitcases","className":"space-y-6 pt-4 scroll-mt-28","children":[["$","h2",null,{"className":"font-serif text-2xl sm:text-3xl text-ink-dark dark:text-paper-50 tracking-tight border-b border-ink-dark/15 dark:border-paper-100/15 pb-2","children":"I. Two Suitcases and a Laptop"}],"$undefined",[["$","p","0",{"className":"font-sans text-base sm:text-lg text-ink-dark/90 dark:text-paper-100/90 leading-relaxed font-normal","children":"Transitioning from high school in Tangerang to university studies in Computer Science and Artificial Intelligence at Tamkang University (淡江大學) in Taiwan has been less about changing countries and more about changing the lens through which I see problems."}],["$","p","1",{"className":"font-sans text-base sm:text-lg text-ink-dark/90 dark:text-paper-100/90 leading-relaxed font-normal","children":"In high school, we collaborated in noisy groups, built short films ('Roda di Balik Gerobak'), debated the ethics of automation, and hacked on hardware with whatever micro-controllers we could find. Here in Tamsui, the pace slows down just enough to force you to think about foundations."}]],"$undefined","$undefined","$undefined",["$","div",null,{"className":"lg:hidden p-3 bg-accent/5 border-l-2 border-accent font-hand text-accent text-sm","children":["Note: ","When you cross borders, you quickly discover which parts of yourself are habit and which parts are core."]}]]}],["$","section","1",{"id":"the-geometry-of-traditional-characters","className":"space-y-6 pt-4 scroll-mt-28","children":[["$","h2",null,{"className":"font-serif text-2xl sm:text-3xl text-ink-dark dark:text-paper-50 tracking-tight border-b border-ink-dark/15 dark:border-paper-100/15 pb-2","children":"II. The Geometry of 繁體字"}],"$undefined",[["$","p","0",{"className":"font-sans text-base sm:text-lg text-ink-dark/90 dark:text-paper-100/90 leading-relaxed font-normal","children":"Studying Traditional Chinese characters (繁體字) has fundamentally reshaped how I write software. Consider a character like 鬱 (melancholy/dense) or 臺 (stage/platform). Every radical inside the character carries historical intent, balance, and weight."}],["$","p","1",{"className":"font-sans text-base sm:text-lg text-ink-dark/90 dark:text-paper-100/90 leading-relaxed font-normal","children":"If you make the left radical too wide, the entire balance collapses. You cannot rush it. In modern frontend engineering, we are taught to throw utilities together at breakneck speed. Traditional calligraphy demands that you respect the negative space."}]],["$","figure",null,{"className":"my-8 py-6 border-y-2 border-accent/40 px-4 sm:px-6 bg-accent/5 dark:bg-accent/10","children":["$","blockquote",null,{"className":"font-serif italic text-xl sm:text-2xl text-ink-dark dark:text-paper-50 leading-snug","children":["“","Negative space is not empty space; it is the tension that allows the form to speak.","”"]}]}],"$undefined","$undefined","$undefined"]}],["$","section","2",{"id":"the-six-principles-cc5","className":"space-y-6 pt-4 scroll-mt-28","children":[["$","h2",null,{"className":"font-serif text-2xl sm:text-3xl text-ink-dark dark:text-paper-50 tracking-tight border-b border-ink-dark/15 dark:border-paper-100/15 pb-2","children":"III. The Six Principles (CC5+)"}],"$undefined",[["$","p","0",{"className":"font-sans text-base sm:text-lg text-ink-dark/90 dark:text-paper-100/90 leading-relaxed font-normal","children":"My school years were grounded in the Tarakanita CC5+ framework: Compassion, Celebration, Community, Conviction, Creativity, and Competence."}],["$","p","1",{"className":"font-sans text-base sm:text-lg text-ink-dark/90 dark:text-paper-100/90 leading-relaxed font-normal","children":"People often assume engineering is detached from morality. But when you build an emergency mesh network like PENJAGA-MOBILE, designed to work when cellular towers collapse, competence without compassion is useless. You are building tools for human survival, not for benchmark bragging rights."}]],"$undefined","$undefined","$undefined","$undefined"]}],["$","section","3",{"id":"what-anchors-a-builder","className":"space-y-6 pt-4 scroll-mt-28","children":[["$","h2",null,{"className":"font-serif text-2xl sm:text-3xl text-ink-dark dark:text-paper-50 tracking-tight border-b border-ink-dark/15 dark:border-paper-100/15 pb-2","children":"IV. What Anchors a Builder"}],"$undefined",[["$","p","0",{"className":"font-sans text-base sm:text-lg text-ink-dark/90 dark:text-paper-100/90 leading-relaxed font-normal","children":"I keep making things I don't completely understand yet. Whether it is an MoE router, a cascaded dual-loop PID algorithm, or learning to slap an intricate 16th-note groove on a four-string bass, the joy has never been in being an expert."}],["$","p","1",{"className":"font-sans text-base sm:text-lg text-ink-dark/90 dark:text-paper-100/90 leading-relaxed font-normal","children":"The joy is in the friction of the unknown — in that quiet, late-night moment when the terminal prints clean output, the string rings true, and the machine comes alive."}]],"$undefined","$undefined","$undefined",["$","div",null,{"className":"lg:hidden p-3 bg-accent/5 border-l-2 border-accent font-hand text-accent text-sm","children":["Note: ","Stay curious. Keep building things with your own hands."]}]]}]],["$","footer",null,{"className":"pt-12 border-t border-ink-dark/20 dark:border-paper-100/20 space-y-4 font-mono text-xs","children":[["$","div",null,{"className":"text-[10px] text-accent uppercase tracking-widest font-bold","children":"[FOOTNOTES & FORMAL CITATIONS]"}],["$","ol",null,{"className":"space-y-2 list-decimal list-inside text-ink-muted text-[11px]","children":[["$","li","1",{"className":"leading-relaxed","children":["$","span",null,{"className":"text-ink-dark dark:text-paper-100 font-sans","children":"Tamkang University (淡江大學) sits on the hillside of Tamsui, overlooking the Taiwan Strait and Guanyin Mountain."}]}],["$","li","2",{"className":"leading-relaxed","children":["$","span",null,{"className":"text-ink-dark dark:text-paper-100 font-sans","children":"Tarakanita CC5+ represents: Compassion, Celebration, Community, Conviction, Creativity, and Competence."}]}]]}]]}]]}],["$","aside",null,{"className":"hidden lg:block lg:col-span-3 space-y-8 font-mono text-xs border-l border-ink-dark/10 dark:border-paper-100/10 pl-6","children":[["$","span",null,{"className":"text-[10px] text-accent font-bold uppercase tracking-widest block","children":"MARGINALIA & NOTES"}],[["$","div","0",{"className":"p-3 bg-paper-100/50 dark:bg-paper-900/50 border border-ink-dark/10 dark:border-paper-100/10 space-y-1 relative","children":[["$","span",null,{"className":"text-[8px] text-accent uppercase tracking-widest block","children":["ANNOTATION § 0",1]}],["$","p",null,{"className":"margin-hand text-base text-accent","children":["“","When you cross borders, you quickly discover which parts of yourself are habit and which parts are core.","”"]}]]}],null,null,["$","div","3",{"className":"p-3 bg-paper-100/50 dark:bg-paper-900/50 border border-ink-dark/10 dark:border-paper-100/10 space-y-1 relative","children":[["$","span",null,{"className":"text-[8px] text-accent uppercase tracking-widest block","children":["ANNOTATION § 0",4]}],["$","p",null,{"className":"margin-hand text-base text-accent","children":["“","Stay curious. Keep building things with your own hands.","”"]}]]}]],["$","div",null,{"className":"p-4 border border-ink-dark/15 dark:border-paper-100/15 bg-paper-100/30 text-[10px] space-y-2","children":[["$","div",null,{"className":"text-accent uppercase font-bold tracking-widest","children":"PERSONAL DISCIPLINE"}],["$","p",null,{"className":"font-sans text-ink-dark/80 dark:text-paper-200/80 leading-normal","children":"All code samples and algorithmic theorems are tested on real silicon before archiving."}]]}]]}]]}]}]]}],null],null],null]},[null,["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","article","children","$5","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[null,["$","$L4",null,{"parallelRouterKey":"children","segmentPath":["children","article","children"],"error":"$undefined","errorStyles":"$undefined","errorScripts":"$undefined","template":["$","$L6",null,{}],"templateStyles":"$undefined","templateScripts":"$undefined","notFound":"$undefined","notFoundStyles":"$undefined"}]],null]},[[[["$","link","0",{"rel":"stylesheet","href":"/_next/static/css/bb17