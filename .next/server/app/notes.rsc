0:["rSRQS_YgWtLNg2hBWzDjQ",[[["",{"children":["notes",{"children":["__PAGE__",{}]}]},"$undefined","$undefined",true],["",{"children":["notes",{"children":["__PAGE__",{},[["$L1",["$","div",null,{"className":"max-w-4xl mx-auto px-4 sm:px-6 lg:px-8 py-8 sm:py-16 space-y-12","children":[["$","header",null,{"className":"space-y-4 border-b-2 border-ink-dark dark:border-paper-50 pb-8","children":[["$","div",null,{"className":"font-mono text-xs text-accent uppercase tracking-widest flex items-center justify-between","children":[["$","span",null,{"children":"[FIELD JOURNAL // UNFILTERED NOTE STREAM]"}],["$","span",null,{"children":["LOCATION: ","Jiuru / Tamsui, Taiwan"]}]]}],["$","h1",null,{"className":"font-serif text-4xl sm:text-6xl text-ink-dark dark:text-paper-50 tracking-tight leading-[1.05]","children":"Field Notes & Marginalia"}],["$","p",null,{"className":"font-sans text-lg sm:text-xl text-ink-muted dark:text-paper-200/80 font-light leading-relaxed","children":"Daily observations, telemetry traces, harmonic experiments, and unfinished thoughts."}]]}],["$","div",null,{"className":"space-y-10","children":[["$","article","note-01",{"className":"border border-ink-dark/15 dark:border-paper-100/15 p-6 bg-paper-100/30 dark:bg-paper-900/30 space-y-4 font-mono text-xs","children":[["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-2 border-b border-ink-dark/10 pb-2 text-[10px]","children":[["$","span",null,{"className":"text-accent font-bold uppercase tracking-widest","children":["[","CONTROL_SYSTEMS","]"]}],["$","div",null,{"className":"text-ink-muted flex items-center gap-3","children":[["$","span",null,{"children":["2026-09-26"," // ","21:14 CST"]}],["$","span",null,{"children":["§ ","Jiuru, Pingtung"]}]]}]]}],["$","p",null,{"className":"font-sans text-base sm:text-lg text-ink-dark dark:text-paper-100 leading-relaxed font-normal","children":"People spend weeks tuning the integral gain (Ki) when their physical mechanism simply has Coulomb friction. If your actuator is physically sticking at low PWM, math won't unstick it — you need a deadband dither or an inner velocity loop that kicks in before the position error integrates into a violent jump."}],["$","div",null,{"className":"p-2.5 bg-paper-50 dark:bg-paper-950 border border-ink-dark/10 text-[11px] text-ink-muted font-mono","children":[["$","span",null,{"className":"text-accent font-bold mr-2","children":"> RAW TELEMETRY:"}],"v2.5.0 PyPI release: anti-windup clamping threshold set to 0.12 * max_effort."]}]]}],["$","article","note-02",{"className":"border border-ink-dark/15 dark:border-paper-100/15 p-6 bg-paper-100/30 dark:bg-paper-900/30 space-y-4 font-mono text-xs","children":[["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-2 border-b border-ink-dark/10 pb-2 text-[10px]","children":[["$","span",null,{"className":"text-accent font-bold uppercase tracking-widest","children":["[","ACOUSTICS_RHYTHM","]"]}],["$","div",null,{"className":"text-ink-muted flex items-center gap-3","children":[["$","span",null,{"children":["2026-09-22"," // ","02:40 CST"]}],["$","span",null,{"children":["§ ","Studio Desk"]}]]}]]}],["$","p",null,{"className":"font-sans text-base sm:text-lg text-ink-dark dark:text-paper-100 leading-relaxed font-normal","children":"Slap bass is 80% thumb pivot geometry and 20% amplification. If you slap through the string like you're playing an electric guitar with a pick, you kill the bounce. Your thumb must rebound off the steel before the string even reaches its maximum excursion. The groove lives in the acoustic rebound."}],["$","div",null,{"className":"p-2.5 bg-paper-50 dark:bg-paper-950 border border-ink-dark/10 text-[11px] text-ink-muted font-mono","children":[["$","span",null,{"className":"text-accent font-bold mr-2","children":"> RAW TELEMETRY:"}],"Metronome locked at 114 BPM. Practice ghost-note triplets on low E."]}]]}],["$","article","note-03",{"className":"border border-ink-dark/15 dark:border-paper-100/15 p-6 bg-paper-100/30 dark:bg-paper-900/30 space-y-4 font-mono text-xs","children":[["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-2 border-b border-ink-dark/10 pb-2 text-[10px]","children":[["$","span",null,{"className":"text-accent font-bold uppercase tracking-widest","children":["[","SPATIAL_CFOP","]"]}],["$","div",null,{"className":"text-ink-muted flex items-center gap-3","children":[["$","span",null,{"children":["2026-09-15"," // ","18:20 CST"]}],["$","span",null,{"children":["§ ","Library"]}]]}]]}],["$","p",null,{"className":"font-sans text-base sm:text-lg text-ink-dark dark:text-paper-100 leading-relaxed font-normal","children":"In 3x3 speedsolving, turning faster than 9 TPS (turns per second) with blind hesitation is worse than turning at 5 TPS with unbroken lookahead. While inserting the front-right F2L pair, your eyes must be scanning the opposite back-left corner for the next edge orientation. Software pipelines are the exact same: pipeline stalls kill throughput."}],["$","div",null,{"className":"p-2.5 bg-paper-50 dark:bg-paper-950 border border-ink-dark/10 text-[11px] text-ink-muted font-mono","children":[["$","span",null,{"className":"text-accent font-bold mr-2","children":"> RAW TELEMETRY:"}],"PB single: 14.82s. Still hesitating on G-perm recognition."]}]]}],["$","article","note-04",{"className":"border border-ink-dark/15 dark:border-paper-100/15 p-6 bg-paper-100/30 dark:bg-paper-900/30 space-y-4 font-mono text-xs","children":[["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-2 border-b border-ink-dark/10 pb-2 text-[10px]","children":[["$","span",null,{"className":"text-accent font-bold uppercase tracking-widest","children":["[","DISTRIBUTED_NETS","]"]}],["$","div",null,{"className":"text-ink-muted flex items-center gap-3","children":[["$","span",null,{"children":["2026-09-08"," // ","23:05 CST"]}],["$","span",null,{"children":["§ ","Tamsui, New Taipei"]}]]}]]}],["$","p",null,{"className":"font-sans text-base sm:text-lg text-ink-dark dark:text-paper-100 leading-relaxed font-normal","children":"The reason Minecraft server networks are fascinating is because Minecraft was never designed for cross-platform protocol translation. When Geyser translates an item click packet from a Bedrock mobile screen into a Java packet sequence, it has to predict inventory desyncs before the Java server sends an ACK. It's an optimistic consistency engine running on coffee and open-source grit."}],["$","div",null,{"className":"p-2.5 bg-paper-50 dark:bg-paper-950 border border-ink-dark/10 text-[11px] text-ink-muted font-mono","children":[["$","span",null,{"className":"text-accent font-bold mr-2","children":"> RAW TELEMETRY:"}],"Paper 1.21.x Netty buffer pool tuning: netty-threads=4, compression-threshold=64."]}]]}],["$","article","note-05",{"className":"border border-ink-dark/15 dark:border-paper-100/15 p-6 bg-paper-100/30 dark:bg-paper-900/30 space-y-4 font-mono text-xs","children":[["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-2 border-b border-ink-dark/10 pb-2 text-[10px]","children":[["$","span",null,{"className":"text-accent font-bold uppercase tracking-widest","children":["[","GAME_THEORY","]"]}],["$","div",null,{"className":"text-ink-muted flex items-center gap-3","children":[["$","span",null,{"children":["2026-08-29"," // ","14:15 WIB"]}],["$","span",null,{"children":["§ ","Tangerang"]}]]}]]}],["$","p",null,{"className":"font-sans text-base sm:text-lg text-ink-dark dark:text-paper-100 leading-relaxed font-normal","children":"In Capsa Banting (Big Two), the novice plays their highest card the moment they feel cornered. The master passes intentionally with a pair of 2s in hand, letting the other players exhaust their high spades. Winning isn't about having the strongest hand; it's about dictating who controls the tempo of the trick."}],["$","div",null,{"className":"p-2.5 bg-paper-50 dark:bg-paper-950 border border-ink-dark/10 text-[11px] text-ink-muted font-mono","children":[["$","span",null,{"className":"text-accent font-bold mr-2","children":"> RAW TELEMETRY:"}],"Combinatorics note: probability of being dealt zero cards above 10 is ~3.2%."]}]]}],["$","article","note-06",{"className":"border border-ink-dark/15 dark:border-paper-100/15 p-6 bg-paper-100/30 dark:bg-paper-900/30 space-y-4 font-mono text-xs","children":[["$","div",null,{"className":"flex flex-wrap items-center justify-between gap-2 border-b border-ink-dark/10 pb-2 text-[10px]","children":[["$","span",null,{"className":"text-accent font-bold uppercase tracking-widest","children":["[","PHILOLOGY","]"]}],["$","div",null,{"className":"text-ink-muted flex items-center gap-3","children":[["$","span",null,{"children":["2026-08-11"," // ","09:45 CST"]}],["$","span",null,{"children":["§ ","Tamsui Waterfront"]}]]}]]}],["$","p",null,{"className":"font-sans text-base sm:text-lg text-ink-dark dark:text-paper-100 leading-relaxed font-normal","children":"The Traditional Chinese character 聽 (to listen) contains five radicals: ear (耳), king (王), ten (十), eye (目), and heart (心). To truly listen requires your ear, your eyes, your undivided presence like a king, and your heart. Modern software needs to listen to hardware with that exact same multidimensional attention."}],["$","div",null,{"className":"p-2.5 bg-paper-50 dark:bg-paper-950 border border-ink-dark/10 text-[11px] text-ink-muted font-mono","children":[["$","span",null,{"className":"text-accent font-bold mr-2","children":"> RAW TELEMETRY:"}],"Practice brush strokes for 聽, 臺, and 龍."]}]]}]]}],["$","div",null,{"className":"pt-8 border-t border-ink-dark/15 flex items-center justify-between font-mono text-xs","children":[["$","$L2",null,{"href":"/","className":"text-accent underline font-bold uppercase","children":"← Return to Journal"}],["$","span",null,{"className":"text-ink-muted","children":"Updated in real-time from Tamsui • 2026"}]]}]]}],null],null],null]},[null,["$","$L3",null,{"parallelRouterKey":"ch